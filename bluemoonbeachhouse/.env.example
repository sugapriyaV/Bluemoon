# Public values only. The anon/publishable key is designed to be visible in the browser —
# your data is protected by the Row Level Security policies in supabase/schema.sql.
# NEVER put a service_role / secret key in any VITE_ variable (the app refuses to start if you do).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
